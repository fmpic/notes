    {
      "type": "text", "id": "engine_core_text", "x": 950, "y": 540, "width": 380, "height": 356,
      "text": "Process B / DP rank · EngineCoreProc\n\ninput IO thread\nDEALER input socket(s)     (connect)\n→ request_type + msgpack + aux\n\nEngineCore\nScheduler + Executor\nrequest state / KV block ownership\n\noutput IO thread\nPUSH output socket(s)      (connect)\n→ select frontend by client_index\n\nengine_index / DP rank routes requests\nEngineCoreProc remains Python", "originalText": "Process B / DP rank · EngineCoreProc\n\ninput IO thread\nDEALER input socket(s)     (connect)\n→ request_type + msgpack + aux\n\nEngineCore\nScheduler + Executor\nrequest state / KV block ownership\n\noutput IO thread\nPUSH output socket(s)      (connect)\n→ select frontend by client_index\n\nengine_index / DP rank routes requests\nEngineCoreProc remains Python",
      "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 20021,
