    {
      "type": "text", "id": "failure_timeline_text", "x": 170, "y": 2030, "width": 2050, "height": 55,
      "text": "Worker exception/death → response FAILURE or Executor failure callback → EXECUTOR_FAILED → ENGINE_CORE_DEAD single frame\n→ Python/Rust EngineCoreClient marks engine dead → AsyncLLM propagates error to request collectors → supervisor shuts down sibling processes", "originalText": "Worker exception/death → response FAILURE or Executor failure callback → EXECUTOR_FAILED → ENGINE_CORE_DEAD single frame\n→ Python/Rust EngineCoreClient marks engine dead → AsyncLLM propagates error to request collectors → supervisor shuts down sibling processes",
      "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#dc2626", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 40032,
      "version": 1, "versionNonce": 40132, "isDeleted": false, "groupIds": ["lifecycle_group"], "boundElements": null,
      "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "shutdown_note", "x": 72, "y": 2105, "width": 2250, "height": 45,
      "text": "所有权决定关闭顺序：frontend manager → EngineCore manager/coordinator → Executor/Worker MQ → process group；graceful drain 超时后才 terminate/kill。", "originalText": "所有权决定关闭顺序：frontend manager → EngineCore manager/coordinator → Executor/Worker MQ → process group；graceful drain 超时后才 terminate/kill。",
      "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
