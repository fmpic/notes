    {
      "type": "text", "id": "pyproject_text", "x": 430, "y": 392, "width": 290, "height": 112,
      "text": "pyproject.toml\n[build-system]\nrequires:\nsetuptools / cmake / ninja / torch\nsetuptools-rust / setuptools-scm\njinja2\nbuild-backend =\nsetuptools.build_meta", "originalText": "pyproject.toml\n[build-system]\nrequires:\nsetuptools / cmake / ninja / torch\nsetuptools-rust / setuptools-scm\njinja2\nbuild-backend =\nsetuptools.build_meta",
      "fontSize": 12, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 20013,
      "version": 1, "versionNonce": 20113, "isDeleted": false, "groupIds": ["entry_group"],
