    },
    {
      "type": "text", "id": "rocm_targets_text", "x": 859, "y": 1014, "width": 232, "height": 97,
      "text": "ROCm / HIPCC\nshared hipify_all\nlegacy _C + stable _C / _moe_C\n_rocm_C (gfx-gated sources)\nreuse .cu → generated .hip\nprefer wheel libamdhip64", "originalText": "ROCm / HIPCC\nshared hipify_all\nlegacy _C + stable _C / _moe_C\n_rocm_C (gfx-gated sources)\nreuse .cu → generated .hip\nprefer wheel libamdhip64",
