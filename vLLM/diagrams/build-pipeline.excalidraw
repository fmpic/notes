    {
      "type": "rectangle", "id": "mapping_evidence", "x": 70, "y": 1790, "width": 1270, "height": 270,
      "strokeColor": "#1e3a5f", "backgroundColor": "#1e293b", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 40031,
