      "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "setuptools_backend_text", "x": 862, "y": 420, "width": 216, "height": 62,
      "text": "setuptools.build_meta\ncreates isolated build env\ninvokes setup.py commands", "originalText": "setuptools.build_meta\ncreates isolated build env\ninvokes setup.py commands",
      "fontSize": 15, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle",
