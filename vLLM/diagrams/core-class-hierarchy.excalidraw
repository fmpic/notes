    {
      "type": "text", "id": "evidence_text", "x": 1225, "y": 173, "width": 1040, "height": 126,
      "text": "class AsyncLLM(EngineClient)\nclass EngineCoreProc(EngineCore)\nclass RayExecutorV2(MultiprocExecutor)   # 不是 RayDistributedExecutor 子类\nclass LlamaForCausalLM(LocalArgmaxMixin, nn.Module, SupportsLoRA, SupportsPP, ...)\nworker_class.__bases__ = worker_class.__bases__ + (worker_extension_cls,)", "originalText": "class AsyncLLM(EngineClient)\nclass EngineCoreProc(EngineCore)\nclass RayExecutorV2(MultiprocExecutor)   # 不是 RayDistributedExecutor 子类\nclass LlamaForCausalLM(LocalArgmaxMixin, nn.Module, SupportsLoRA, SupportsPP, ...)\nworker_class.__bases__ = worker_class.__bases__ + (worker_extension_cls,)",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
