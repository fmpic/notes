    },
    {
      "type": "rectangle", "id": "s4_coord", "x": 120, "y": 1220, "width": 470, "height": 135,
      "strokeColor": "#1e3a5f", "backgroundColor": "#93c5fd", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500005, "version": 1, "versionNonce": 500006, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "s4_coord_text", "x": 150, "y": 1242, "width": 410, "height": 92,
      "text": "MP Coordinator · FastAPI / REST\nPOST /instances · heartbeat · GET /instances\nL2 quota / usage / eviction / resync\nGlobalBlendMatcher\n失败：best-effort，不停止 cache serving", "originalText": "MP Coordinator · FastAPI / REST\nPOST /instances · heartbeat · GET /instances\nL2 quota / usage / eviction / resync\nGlobalBlendMatcher\n失败：best-effort，不停止 cache serving",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500007, "version": 1, "versionNonce": 500008, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "rectangle", "id": "s4_operator", "x": 790, "y": 1220, "width": 610, "height": 135,
      "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500009, "version": 1, "versionNonce": 500010, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "s4_operator_text", "x": 825, "y": 1238, "width": 540, "height": 100,
      "text": "Kubernetes Operator\nLMCacheEngine / CacheBlendEngine → DaemonSet\nLMCacheCoordinator → Deployment\nService(internalTrafficPolicy=Local) · ConfigMap · ServiceMonitor\nHostIPC=true · no hostNetwork", "originalText": "Kubernetes Operator\nLMCacheEngine / CacheBlendEngine → DaemonSet\nLMCacheCoordinator → Deployment\nService(internalTrafficPolicy=Local) · ConfigMap · ServiceMonitor\nHostIPC=true · no hostNetwork",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle",
      "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500011, "version": 1, "versionNonce": 500012, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "rectangle", "id": "s4_obs", "x": 1600, "y": 1220, "width": 665, "height": 135,
      "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 500013, "version": 1, "versionNonce": 500014, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "s4_obs_text", "x": 1640, "y": 1240, "width": 585, "height": 95,
      "text": "EventBus → Subscribers → OTel / Prometheus / Logs\npublish() 非阻塞 · 单独 drain thread\nCUDA stream event 用 native host recorder\n队列满 tail-drop；subscriber exception 隔离\n观测失败 ≠ cache correctness 失败", "originalText": "EventBus → Subscribers → OTel / Prometheus / Logs\npublish() 非阻塞 · 单独 drain thread\nCUDA stream event 用 native host recorder\n队列满 tail-drop；subscriber exception 隔离\n观测失败 ≠ cache correctness 失败",
      "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle",
