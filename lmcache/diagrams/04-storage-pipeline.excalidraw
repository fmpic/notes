    {"type":"text","id":"p2_plan_text","x":1322,"y":1142,"width":145,"height":74,"text":"PrefetchPolicy\nselect_load_plan()\nPREFIX: 首个 gap 截断\nSPARSE/SEGMENTED:\n保留全部 set bits","originalText":"PrefetchPolicy\nselect_load_plan()\nPREFIX: 首个 gap 截断\nSPARSE/SEGMENTED:\n保留全部 set bits","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1600023,"version":1,"versionNonce":1600024,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
