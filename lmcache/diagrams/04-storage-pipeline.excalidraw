    {"type":"text","id":"p2_finalize_text","x":2230,"y":1118,"width":240,"height":122,"text":"_finalize_load()\nunlock 全部 L2 plan keys\nloaded: finish_write_and_reserve_read\nfailed: finish_write + delete\n释放 gap 后多余 L1 read locks\n_complete_request(Bitmap) one-shot\nstop() 清理所有 in-flight locks","originalText":"_finalize_load()\nunlock 全部 L2 plan keys\nloaded: finish_write_and_reserve_read\nfailed: finish_write + delete\n释放 gap 后多余 L1 read locks\n_complete_request(Bitmap) one-shot\nstop() 清理所有 in-flight locks","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1600035,"version":1,"versionNonce":1600036,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
