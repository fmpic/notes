    {"type":"text","id":"p1_evidence_text","x":125,"y":878,"width":2335,"height":48,"text":"Store 锁不变量：UNLOCKED → reserve_read → READ-LOCKED during L2 store → finish_read → UNLOCKED\n源码：distributed/storage_controllers/store_controller.py: StoreListener · _process_new_keys · _drain_l2_store_completions · _finalize_store · _cleanup_in_flight_tasks","originalText":"Store 锁不变量：UNLOCKED → reserve_read → READ-LOCKED during L2 store → finish_read → UNLOCKED\n源码：distributed/storage_controllers/store_controller.py: StoreListener · _process_new_keys · _drain_l2_store_completions · _finalize_store · _cleanup_in_flight_tasks","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1500047,"version":1,"versionNonce":1500048,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
