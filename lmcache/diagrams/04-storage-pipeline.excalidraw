    {"type":"text","id":"p2_lookup_text","x":690,"y":1128,"width":270,"height":103,"text":"LOOKUP phase\n对每个 L2 adapter：\nsubmit_lookup_and_lock_task(keys, layout)\n等待所有 lookup eventfds\nquery_lookup_and_lock_result() → Bitmap\nL2 found keys 已锁定","originalText":"LOOKUP phase\n对每个 L2 adapter：\nsubmit_lookup_and_lock_task(keys, layout)\n等待所有 lookup eventfds\nquery_lookup_and_lock_result() → Bitmap\nL2 found keys 已锁定","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1600015,"version":1,"versionNonce":1600016,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
