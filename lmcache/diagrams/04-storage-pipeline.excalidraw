    {"type":"text","id":"p2_load_text","x":1610,"y":1118,"width":300,"height":122,"text":"PLAN_AND_LOAD phase\nL1 reserve_write(is_temporary=True)\nunlock L2 keys 不在最终 plan\nsubmit_load_task(keys, L1 buffers)\n等待 load eventfds\nquery_load_result() → Bitmap\nL1 write locks + L2 plan locks 持续到完成","originalText":"PLAN_AND_LOAD phase\nL1 reserve_write(is_temporary=True)\nunlock L2 keys 不在最终 plan\nsubmit_load_task(keys, L1 buffers)\n等待 load eventfds\nquery_load_result() → Bitmap\nL1 write locks + L2 plan locks 持续到完成","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1600027,"version":1,"versionNonce":1600028,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
