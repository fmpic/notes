    {"type":"text","id":"m1_end_s","x":1400,"y":985,"width":440,"height":75,"text":"LookupModule.free_lookup_locks()\nLookupModule.end_session()\nSessionManager.remove() · MP_REQUEST_END\ntouch unified retrieved/stored keys\nmissing session → warning + no-op","originalText":"LookupModule.free_lookup_locks()\nLookupModule.end_session()\nSessionManager.remove() · MP_REQUEST_END\ntouch unified retrieved/stored keys\nmissing session → warning + no-op","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1200063,"version":1,"versionNonce":1200064,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
