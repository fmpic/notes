    {"type":"text","id":"m2_frame_text","x":100,"y":1210,"width":700,"height":330,"text":"协议帧 · lmcache/v1/multiprocess/mq.py\n\nClient DEALER sends:\n[request_uid] [RequestType] [payload_0] ...\n\nServer ROUTER sees:\n[identity] [request_uid] [RequestType] [payload_0] ...\n\nResponse:\n[identity] [request_uid] [RequestType] [optional_response]\n\nmsgspec MessagePack strict type validation\n特殊 Ext: DeviceIPCWrapper · MemoryLayoutDesc\nrequest_uid → MessagingFuture\npayload mismatch → likely client/server version skew","originalText":"协议帧 · lmcache/v1/multiprocess/mq.py\n\nClient DEALER sends:\n[request_uid] [RequestType] [payload_0] ...\n\nServer ROUTER sees:\n[identity] [request_uid] [RequestType] [payload_0] ...\n\nResponse:\n[identity] [request_uid] [RequestType] [optional_response]\n\nmsgspec MessagePack strict type validation\n特殊 Ext: DeviceIPCWrapper · MemoryLayoutDesc\nrequest_uid → MessagingFuture\npayload mismatch → likely client/server version skew","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1300003,"version":1,"versionNonce":1300004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
